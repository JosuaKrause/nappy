{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(./tools/prune-merged.sh:*)",
      "Bash(tools/prune-merged.sh:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-rules.sh\"",
            "timeout": 10,
            "statusMessage": "Loading the rules that come before the first edit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/project-rules.sh\"",
            "timeout": 10,
            "statusMessage": "Loading the rules for this file"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/git-grep-guard.sh\"",
            "timeout": 5,
            "statusMessage": "Checking for an unbounded git grep"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/lint-docs.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the doc for volatile facts"
          }
        ]
      }
    ]
  }
}
