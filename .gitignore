# Godot 4
.godot/
/android/
/build/
/export/

# Godot export presets often carry credentials (a keystore password, a signing identity) and are
# usually left untracked for that reason. export_presets.cfg is tracked in this repo because its
# only preset is Web, which carries none — a preset for a platform that does carry one belongs
# back on an ignore line, not beside this one in the tracked file.

# The baked atlas pages and their region table. A build output, not a source: tools/bake-atlases.sh
# rebuilds them from assets/atlases/membership.json and the pictures it names whenever a source
# hash changes, and every tool that needs them (check.sh, test.sh, run.sh, export-web.sh) calls it
# first. Committing them would be committing a derived file that nothing verifies and that every
# art change silently invalidates. The .import sidecars go with them, since a sidecar inside an
# ignored folder cannot be committed either — the bake writes them itself.
/assets/atlases/baked/

# OS
.DS_Store
Thumbs.db

# Environment
.env

# Editor
*.swp
.idea/
.vscode/

# Python tooling environment, managed by uv from pyproject.toml and uv.lock.
.venv/
__pycache__/

# tools/test.sh stages tests/runner_fixtures/unparseable_suite.gd.src to this real .gd path for
# the one process that names it, and removes it (and the .uid Godot writes beside it) as soon as
# that process ends. Ignored as well, so an interrupted run never leaves a parse-broken .gd
# sitting where a later commit could pick it up.
/tests/runner_fixtures/unparseable_suite.gd
/tests/runner_fixtures/unparseable_suite.gd.uid

# Agent worktrees (full checkouts; never content of the repo itself)
.claude/worktrees/

# Per-session agent briefs the orchestrator writes before spawning (tools/agent-status.sh reads
# them back). Local working state, never repo content.
.claude/briefs/

# The session-end restart prompt (session-cleanup): local, rewritten by every handover
.claude/restart-prompt.md
