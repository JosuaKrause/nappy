diff --git a/src/events/event_instance.gd b/src/events/event_instance.gd
index 06831ec2..78c2f0da 100644
--- a/src/events/event_instance.gd
+++ b/src/events/event_instance.gd
@@ -1507,11 +1507,29 @@ func _become_solid_once_it_starts() -> void:
 		return
 	_build_obstruction()
 
+var _m205_next := 0.0
+func _m205_probe() -> void:
+	if def.id != "homeless_yeller":
+		return
+	var now := Time.get_ticks_msec() / 1000.0
+	if now < _m205_next:
+		return
+	_m205_next = now + 1.0
+	var d := INF if player_at == Vector2.INF else global_position.distance_to(player_at)
+	if d > 400.0:
+		return
+	var at_player := contribution_at(player_at)
+	print("[M205] id=%d d=%.1f c_player=%.3f cur=%.3f age=%.2f rims=%d rims_peak_1s=%d rim_alpha=%s" % [
+		get_instance_id(), d, at_player, current_intensity(), age,
+		EntityHalo.m205_alive, EntityHalo.m205_take_peak(),
+		[_halo.get("_target_alpha"), _halo.get("_alpha")] if _halo else null])
+
 func _process(delta: float) -> void:
 	if is_finished:
 		return
 	_clock += delta
 	age += delta
+	_m205_probe()
 	# The gait phase advances by whatever this tick actually adds to `_path_travelled` below,
 	# whichever branch does the adding (`_leave`, `_advance_along_path`, `_chase`) or none of them
 	# — see `_advance_gait()`, called once at every exit from this function.
diff --git a/src/ui/entity_halo.gd b/src/ui/entity_halo.gd
index 7c1ba2a5..282ccfd9 100644
--- a/src/ui/entity_halo.gd
+++ b/src/ui/entity_halo.gd
@@ -120,7 +120,26 @@ const COMPATIBILITY_RIM_BLOCKS := 256 / 16
 ## it, so the picked sources alone can never fill it and a wait always ends with a fade.
 const RIM_BUDGET := COMPATIBILITY_RIM_BLOCKS - 1
 
+static var m205_alive := 0
+static var m205_peak := 0
+static var m205_window_peak := 0
+static var m205_window_end := 0.0
+## The most rims alive at once over the last whole second, the window rolling over at most once a
+## second however many probes ask.
+static func m205_take_peak() -> int:
+	var now := Time.get_ticks_msec() / 1000.0
+	if now >= m205_window_end:
+		m205_window_end = now + 1.0
+		m205_window_peak = m205_peak
+		m205_peak = m205_alive
+	return m205_window_peak
+func _notification(what: int) -> void:
+	if what == NOTIFICATION_PREDELETE:
+		m205_alive -= 1
+
 func _init(draw_body: Callable, bob: Callable) -> void:
+	m205_alive += 1
+	m205_peak = maxi(m205_peak, m205_alive)
 	_draw_body = draw_body
 	_bob = bob
 	name = "Halo"
