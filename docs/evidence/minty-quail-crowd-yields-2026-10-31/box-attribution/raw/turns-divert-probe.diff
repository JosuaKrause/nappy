 	_turn_back_hold = maxf(0.0, _turn_back_hold - delta)
@@ -469,7 +470,9 @@ func step(delta: float) -> void:
 		return
 	# A closed tile within reach, or for a car a parked figure in its lane (inbox #909): the same
 	# turn round either way.
-	if _blocked_in <= _acts_within or strategy.blocked_by_a_figure():
+	var by_figure: bool = strategy.blocked_by_a_figure()
+	if _blocked_in <= _acts_within or by_figure:
+		probe_note(self, by_figure, _blocked_in <= _acts_within)
 		strategy.divert(delta)
 	# A car with no road either way goes when nobody is looking, which is the rule a body a pocket
 	# has caught already follows. It is the same situation read off the lane instead of off the
@@ -1226,3 +1229,41 @@ func _dress() -> void:
 ## two, because each hook is a call every agent pays every frame.
 func _end_the_frame(_delta: float) -> bool:
 	return false
+
+
+# ---- PROBE INSTRUMENTATION (measuring only; not committed) ----
+static var PROBE := {"diverts_fig_only": 0, "diverts_fig_and_tile": 0, "diverts_tile_only": 0,
+		"episodes": [], "tracked": {}, "resolve": Callable()}
+
+static func probe_note(agent, by_figure: bool, by_tile: bool) -> void:
+	if not (by_figure or by_tile):
+		return
+	if by_figure and by_tile:
+		PROBE.diverts_fig_and_tile += 1
+	elif by_figure:
+		PROBE.diverts_fig_only += 1
+	else:
+		PROBE.diverts_tile_only += 1
+	if not by_figure:
+		return
+	var id: int = agent.get_instance_id()
+	if PROBE.tracked.has(id):
+		return
+	var near := {"row": "?", "state": "?", "dist": -1.0}
+	if PROBE.resolve.is_valid():
+		near = PROBE.resolve.call(agent)
+	PROBE.tracked[id] = {"agent": agent, "frame": Engine.get_physics_frames(), "heading": agent.heading(),
+			"pos": agent.global_position, "tile_too": by_tile, "figure": near, "turned_at": -1,
+			"arc_at": -1, "speed0": agent.speed(), "cause": ""}
+
+static func probe_watch(agent) -> void:
+	var id: int = agent.get_instance_id()
+	if not PROBE.tracked.has(id):
+		return
+	var rec: Dictionary = PROBE.tracked[id]
+	var frame := Engine.get_physics_frames()
+	if rec.arc_at < 0 and agent._turn:
+		rec.arc_at = frame - rec.frame
+	if rec.turned_at < 0 and agent.heading().dot(rec.heading) < -0.5:
+		rec.turned_at = frame - rec.frame
+		rec.cause = str(agent.strategy.turn_round_cause)
