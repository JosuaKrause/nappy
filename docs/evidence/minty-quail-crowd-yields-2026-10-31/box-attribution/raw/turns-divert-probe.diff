+
+## The parked figure nearest ahead of a car (PROBE instrumentation): its row, state and distance.
+func _resolve_figure(agent) -> Dictionary:
+	return {"row": _row_of_nearest_parked(agent), "state": "parked", "dist": 0.0}
+
+var _the_city: City
+
+func _row_of_nearest_parked(agent) -> String:
+	var best := INF
+	var row := "unmapped"
+	for instance in _the_city.events.instances():
+		if not is_instance_valid(instance) or instance.is_queued_for_deletion():
+			continue
+		var move: MoveProposal = instance._move
+		if not move.parked:
+			continue
+		var d: float = (move.to - agent.global_position).length()
+		if d < best:
+			best = d
+			row = instance.def.id
+	return row
